# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=123456:replace-with-bot-token
TELEGRAM_ADMIN_USER_IDS=123456789

# TMDB API Token (v3 32位 或 v4 Read Access Token)
TMDB_TOKEN=replace-with-tmdb-token

# HDHive 代理配置
HDHIVE_BASE_URL=https://你的HDHive代理地址
HDHIVE_SECRET=replace-with-shared-secret
HDHIVE_USER_ID=replace-with-user-id
HDHIVE_USER_KEY=replace-with-user-key

# 数据库配置
SQLITE_DSN=file:/data/bot.db

# 加密密钥 (openssl rand -base64 32)
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# HTTP 代理 (可选，用于访问 Telegram/TMDB/HDHive/115)
# 例如：http://192.168.1.100:7890 或 socks5://127.0.0.1:1080
HTTP_PROXY_URL=

# 超时配置
HTTP_TIMEOUT=30s
TMDB_TIMEOUT=15s
HDHIVE_TIMEOUT=30s
P115_TIMEOUT=30s

# 115 配置 (可选)
P115_USER_AGENT=
P115_ENDPOINT=https://proapi.115.com

# Session 配置
SESSION_TTL=30m
SESSION_CAPACITY=1000
